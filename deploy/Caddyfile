# Intermission edge (spec: "Hosting and deployment" step 6, "System architecture").
#
# Tailscale Funnel terminates TLS on the host and forwards to 127.0.0.1:8080, which compose
# maps to this container's :8080. Caddy therefore speaks plain HTTP and never manages
# certificates. It serves the built SPA, proxies /api/* and /healthz to recs-api, and sets the
# security headers. Nothing else is reachable: no admin API, no /metrics, no debug routes.

{
	# No admin endpoint (it would otherwise listen on localhost:2019 inside the container).
	admin off
	# Funnel owns TLS; never try to obtain certificates or redirect to HTTPS.
	auto_https off
	persist_config off

	servers :8080 {
		# HTTP/1.1 only. Funnel speaks HTTP/1.1 to us, and with h2c a client can hold a stream
		# open far past these timeouts by trickling frames (security audit SA3-1).
		protocols h1
		timeouts {
			read_header 5s
			read_body 15s
			write 30s
			idle 2m
		}
		max_header_size 16KB
		# trusted_proxies is deliberately unset: the client address Caddy sees is the Docker
		# gateway, and forwarded headers from the internet are not trusted. See
		# deploy/runbooks/funnel-setup.md ("Does Funnel pass the client IP?").
	}

	# Caddy's own logs (startup, and http.log.error lines, which carry the request). Filtered
	# like the access log below (keep the two field lists in sync).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}

(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		# Set only if the response has none: recs-api sends a stricter sandbox CSP with poster
		# placeholders (SVG) and it must survive (security audit SA5-7).
		?Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
		-X-Powered-By
	}
}

:8080 {
	# JSON access log on stdout with only what operations needs: method, path (the query string
	# is cut off: it may carry search terms), status, duration, size and request_id (recs-api's
	# X-Request-ID, to correlate with its own log). No request or response headers (cookies,
	# User-Agent, ...) and no client address (security audit SA3-2, SA5-2).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>tls delete
				resp_headers delete
			}
		}
	}
	log_append request_id {http.response.header.X-Request-ID}

	# gzip only. Caddy 2.11.9 bundles a klauspost/compress whose zstd path is affected by
	# GO-2026-6865 (security audit SA4-2). Put zstd back (`encode zstd gzip`) once the pinned
	# Caddy release ships a fixed klauspost/compress (check `govulncheck -mode=binary` on it).
	encode gzip

	# Applied to every response, including proxied ones (defer = run when the response is
	# written, after the upstream's own headers). Errors Caddy raises itself are answered by
	# handle_errors below, which imports the same headers.
	import security_headers

	# Internal endpoints are never proxied (recs-api's /metrics is scraped on the internal
	# network only). Matched before the SPA fallback so they 404 instead of returning index.html.
	@internal path /metrics /metrics/* /debug/* /debug
	handle @internal {
		respond 404
	}

	handle /api/* {
		# 64 KB cap on request bodies (spec). Larger bodies get 413 from Caddy.
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8081 {
			# Host is preserved by default; recs-api's CrossOriginProtection compares Origin
			# with Host, so it must stay the public hostname.
			transport http {
				dial_timeout 2s
				response_header_timeout 15s
			}
		}
	}

	handle /healthz {
		reverse_proxy api:8081 {
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	# Hashed build assets: served when they exist and cached forever; a missing one is a plain
	# 404 (handle_errors), never index.html with an immutable cache header (security audit
	# SA3-3).
	handle /assets/* {
		root * /srv/www
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The SPA: real files when they exist, otherwise index.html (client-side routing).
	handle {
		root * /srv/www
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Errors raised by Caddy itself (not by recs-api): above all the 64 KB body cap, but also an
	# unreachable recs-api. They get the security headers, no Server header, an X-Request-ID
	# and, for the body cap, the public API's Error shape (contracts/public.yaml: 413
	# body_too_large), the same answer recs-api gives.
	handle_errors {
		import security_headers
		header X-Request-ID {http.request.uuid}
		header Cache-Control no-store
		@too_large expression {err.status_code} == 413
		handle @too_large {
			header Content-Type application/json
			# Caddy's 64KB is 64,000 bytes (recs-api's own cap is 64 KiB = 65,536 bytes).
			respond `{"error":{"code":"body_too_large","message":"request body exceeds 64,000 bytes"}}` 413
		}
		# Caddy reports a request body that stopped arriving (read_body timeout) as 499
		# ("client closed request"), a non-standard code meant for logs. The client may still
		# be there: answer 408 and close (security audit SA3-5).
		@body_stalled expression {err.status_code} == 499
		handle @body_stalled {
			header Connection close
			respond "" 408
		}
		handle {
			respond "" {err.status_code}
		}
	}
}
