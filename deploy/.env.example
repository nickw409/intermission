# Copy to deploy/.env (gitignored) and fill in. Never commit deploy/.env.
#   install -m 0600 deploy/.env.example deploy/.env
# Every value here is a placeholder. The deploy scripts refuse to run while any value still
# starts with "change-me", and force this file to mode 0600.

# Image set to run: short git SHA. deploy/release.sh rewrites this line.
TAG=0000000

# Public origin of the site (scheme://host, no path). recs-api's CSRF check compares the
# browser's Origin header with it. Production: https://intermission.<tailnet-name>.ts.net
RECS_SITE_ORIGIN=http://localhost:8080

# invite (launch default) | open — switching to open is an owner decision (runbooks/open-signup.md).
RECS_SIGNUP_MODE=invite
RECS_LOG_LEVEL=info

# TMDB API key for posters and movie details (owner-only; runbooks/rotate-tmdb-key.md). Empty = placeholders.
TMDB_API_KEY=

# Host data directory (default: ../data relative to deploy/, i.e. the repo's data/).
# RECS_DATA_DIR=../data
# Directory of per-model training configs mounted read-only into the train job (default: the
# repo's configs/). recs-train uses <model>.<dataset>.tuned.json if present, else <model>.json.
# RECS_CONFIG_DIR=../configs
# Loopback port caddy publishes (Funnel targets 127.0.0.1:8080). Only the restore drill
# changes it.
# RECS_HTTP_PORT=8080
# Development stack (compose.dev.yaml, project intermission-dev): its own data and port.
# RECS_DEV_DATA_DIR=../data/dev
# RECS_DEV_HTTP_PORT=8088

# Nightly retrain on this host: local (default) | off. Use off on a host that only serves (the
# Raspberry Pi; training runs on another machine). Export and backup still run nightly.
# RECS_NIGHTLY_RETRAIN=local

# Resource knobs.
# MODEL_MEM_LIMIT=4g
# MODEL_OMP_THREADS=2
# TRAIN_MEM_LIMIT=12g
# TRAIN_OMP_THREADS=4

# Smoke-test account (deploy/smoke.sh). Create it once with an invite; it holds a few ratings
# so recommendations are non-trivial. Use a long random password, not one used anywhere else.
SMOKE_USERNAME=smoke-test
SMOKE_PASSWORD=change-me-to-a-long-random-password
# Model the smoke test asks for (pop is always present).
SMOKE_MODEL=pop

# Optional monitoring profile.
# Docker on WSL2 rejects rslave propagation for node-exporter's data mount: uncomment there.
# NODE_EXPORTER_DATA_PROPAGATION=
GRAFANA_ADMIN_PASSWORD=change-me-too
