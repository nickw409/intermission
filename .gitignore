# Data, artifacts and local state (never commit; MovieLens license + privacy)
/data/
*.db
*.db-wal
*.db-shm
*.sqlite*

# Secrets
.env
.env.*
!.env.example
*.pem
# Private keys, anywhere (public repo).
*.key

# Logs, backups and archives (may hold personal data)
*.log
/logs/
/deploy/logs/
*.bak
/backups/
/deploy/backups/
*.tar
*.tar.*
*.zst

# Builds
/build*/
/out/
/web/node_modules/
**/node_modules/
/web/dist/
/api/bin/
*.o
*.a
compile_commands.json

# Fuzzing and profiling output
/crash-*
/tests/fuzz/**/crash-*
/leak-*
/tests/fuzz/**/leak-*
/timeout-*
/tests/fuzz/**/timeout-*
/oom-*
/tests/fuzz/**/oom-*
*.profraw
*.prof

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp

# Local Claude Code settings
.claude/settings.local.json

# Agent worktrees (local only)
/.claude/worktrees/
